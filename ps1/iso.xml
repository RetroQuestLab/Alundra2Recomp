<?xml version="1.0" encoding="utf-8"?>
<!-- Mastering du portage PS1 natif d'Alundra 2. Aucune ressource proprietaire. -->
<iso_project>
	<track type="data">
		<identifiers
			system			="PLAYSTATION"
			volume			="ALUNDRA2_PS1"
			volume_set		="ALUNDRA2_PS1"
			publisher		="ALUNDRA2 REMAKE"
			data_preparer	="PSN00BSDK ${PSN00BSDK_VERSION}"
			application		="PLAYSTATION"
			copyright		="README.TXT;1"
		/>

		<directory_tree>
			<file name="SYSTEM.CNF"	type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="ALUNDRA2.EXE"	type="data" source="alundra2.exe" />

			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
